{
  "name": "agent-sdk-cli-template",
  "version": "1.0.0",
  "description": "Brand your Agent SDK. The white-label CLI template for Claude Agent SDK.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "tsx src/cli.ts",
    "dev": "tsx --watch src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "keywords": [
    "claude",
    "agent",
    "sdk",
    "cli",
    "template",
    "white-label",
    "terminal",
    "anthropic",
    "ai",
    "chatbot",
    "assistant"
  ],
  "author": "SmokeAlot420",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SmokeAlot420/claude-cli-template"
  },
  "homepage": "https://github.com/SmokeAlot420/claude-cli-template#readme",
  "bugs": {
    "url": "https://github.com/SmokeAlot420/claude-cli-template/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "agent-sdk-cli-template": "./bin/create.js",
    "fbs": "./bin/cli.js"
  },
  "files": [
    "dist/",
    "bin/",
    "template/",
    ".claude/commands/",
    ".claude/sections/",
    "README.md",
    "CLAUDE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./branding": {
      "types": "./dist/branding.d.ts",
      "import": "./dist/branding.js"
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.3",
    "@types/react": "^18.2.0",
    "@types/uuid": "^10.0.0",
    "better-sqlite3": "^12.5.0",
    "gray-matter": "^4.0.3",
    "ink": "^5.0.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.2.0",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.39.2",
    "fast-check": "^4.5.3",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.51.0",
    "vitest": "^4.0.16"
  }
}
